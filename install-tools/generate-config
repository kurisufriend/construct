#!/usr/bin/env bash


set +x
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
read -r -p "host? " hostn
host_config=$(nix-instantiate --eval --json --strict "$repo_dir/hosts.nix" | jq -ce --arg host "$hostn" '.[$host] | select(type == "object")')
tgtdisk=$(jq -er '.["install-to"]' <<< "$host_config")
fde=$(jq -er '.fde' <<< "$host_config")
style=$(jq -er '.style' <<< "$host_config")
swap=$(jq -er '.swap' <<< "$host_config")
[[ "$fde" == pass || "$fde" == tpm ]] || { echo "Unsupported FDE mode: $fde" >&2; exit 1; }
[[ "$style" == uefi || "$style" == bios ]] || { echo "Unsupported boot style: $style" >&2; exit 1; }
[[ "$swap" == none || "$swap" == hibernate ]] || { echo "Unsupported swap mode: $swap" >&2; exit 1; }
if [[ $(jq -r .filesystem <<< "$host_config") == zfs ]]; then
    echo "Install using nixos-install --flake /mnt/state/construct#$hostn"
    exit 0
fi
root_label=illegalporn
swap_label=swappy
if [[ "$hostn" == cozen ]]; then
    root_label=cozen-root
    swap_label=cozen-swap
fi
OVERRIDE="/mnt/etc/nixos/overrides.nix"

cat <<EOF > "$OVERRIDE"
{ config, pkgs, lib, ... }:
{
  # :)

  networking.hostName = "$hostn";
  nixpkgs.config.allowUnfree = true;

  fileSystems."/" = { 
    device = lib.mkForce "/dev/disk/by-label/nixos"; 
    fsType = "ext4"; 
  };
  fileSystems."/boot" = { 
    device = lib.mkForce "/dev/disk/by-label/boot"; 
    fsType = "vfat"; 
  };

  boot.initrd.luks.devices."cryptroot" = {device = lib.mkForce "/dev/disk/by-partlabel/$root_label";};
  
  boot.initrd.systemd.enable = true;
EOF

if [ "$swap" == "hibernate" ]; then
cat <<EOF >> "$OVERRIDE"
  boot.initrd.luks.devices."cryptswap" = {device = "/dev/disk/by-partlabel/$swap_label";};
  
  swapDevices = lib.mkForce [ { device = "/dev/mapper/cryptswap"; } ];
  boot.resumeDevice = "/dev/mapper/cryptswap";
EOF
fi

if [ "$style" == "uefi" ]; then
    cat <<EOF >> "$OVERRIDE"
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
EOF
else
    sed -i 's|fsType = "vfat"|fsType = "ext4"|' "$OVERRIDE"
    
    cat <<EOF >> "$OVERRIDE"
  boot.loader.grub.enable = true;
  boot.loader.grub.version = 2;
  boot.loader.grub.device = "$tgtdisk";
EOF
fi

if [ "$fde" == "tpm" ]; then
    cat <<EOF >> "$OVERRIDE"
  boot.initrd.availableKernelModules = [ "tpm_tis" "tpm_crb" ];
  boot.initrd.luks.devices."cryptroot".crypttabExtraOpts = [ "tpm2-device=auto" ];
EOF
    if [ "$swap" == "hibernate" ]; then
        echo '  boot.initrd.luks.devices."cryptswap".crypttabExtraOpts = [ "tpm2-device=auto" ];' >> "$OVERRIDE"
    fi
fi

echo "}" >> "$OVERRIDE"

sed -i 's|./hardware-configuration.nix|./hardware-configuration.nix ./overrides.nix|' "/mnt/etc/nixos/configuration.nix"
