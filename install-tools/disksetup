#!/usr/bin/env bash

set +x
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
read -r -p "host? " hostn
host_config=$(nix-instantiate --eval --json --strict "$repo_dir/hosts.nix" | jq -ce --arg host "$hostn" '.[$host] | select(type == "object")')
tgtdisk=$(jq -er '.["install-to"]' <<< "$host_config")
fde=$(jq -er '.fde' <<< "$host_config")
style=$(jq -er '.style' <<< "$host_config")
swap=$(jq -er '.swap' <<< "$host_config")
[[ "$fde" == pass || "$fde" == tpm ]] || { echo "Unsupported FDE mode: $fde" >&2; exit 1; }
[[ "$style" == uefi || "$style" == bios ]] || { echo "Unsupported boot style: $style" >&2; exit 1; }
[[ "$swap" == none || "$swap" == hibernate ]] || { echo "Unsupported swap mode: $swap" >&2; exit 1; }
filesystem=$(jq -r '.filesystem // "ext4"' <<< "$host_config")
if [[ "$filesystem" == zfs ]]; then
    command -v zpool >/dev/null
    modprobe zfs
    if zpool list -H "$hostn" >/dev/null 2>&1; then echo "Pool already imported" >&2; exit 1; fi
fi
root_label=illegalporn
swap_label=swappy
if [[ "$hostn" == cozen || "$filesystem" == zfs ]]; then
    root_label=$hostn-root
    swap_label=$hostn-swap
fi

[[ -b "$tgtdisk" ]] || { echo "Not a block device: $tgtdisk" >&2; exit 1; }
printf 'Erase %s for %s (%s, %s FDE, %s swap).\n' "$tgtdisk" "$hostn" "$style" "$fde" "$swap"
read -r -p "Type the full disk path to confirm: " confirmation
[[ "$confirmation" == "$tgtdisk" ]] || { echo 'Cancelled.' >&2; exit 1; }

partition_prefix=$tgtdisk
[[ "$tgtdisk" =~ [0-9]$ ]] && partition_prefix+=p

# disk shit

wipefs -a "$tgtdisk"
parted "$tgtdisk" -- mklabel gpt

## calc swap size
swapsize=$(($(awk '/MemTotal/ {print $2}' /proc/meminfo) / 1024 + 1024)) #1g buffer

## boot part

if [ "$style" == "uefi" ]; then
    p1_start=1
    p1_end=$((p1_start + 512))
    
    parted "$tgtdisk" -- mkpart ESP fat32 ${p1_start}MiB ${p1_end}MiB
    parted "$tgtdisk" -- set 1 esp on
    BOOT_PART="${partition_prefix}1"
    
    NEXT_START=$p1_end
else
    p1_start=1 # bios, so we have another lil part for boot
    p1_end=2
    
    p2_start=$p1_end
    p2_end=$((p2_start + 512))
    
    parted "$tgtdisk" -- mkpart "BIOS boot partition" fat32 ${p1_start}MiB ${p1_end}MiB
    parted "$tgtdisk" -- set 1 bios_grub on
    
    parted "$tgtdisk" -- mkpart primary ext4 ${p2_start}MiB ${p2_end}MiB
    BOOT_PART="${partition_prefix}2"
    
    NEXT_START=$p2_end
fi

## swap and root

if [ "$swap" == "hibernate" ]; then
    swap_end=$((NEXT_START + swapsize))
    
    parted "$tgtdisk" -- mkpart primary linux-swap ${NEXT_START}MiB ${swap_end}MiB
    
    if [ "$style" == "uefi" ]; then
        SWAP_PART="${partition_prefix}2"
        ROOT_PART="${partition_prefix}3"
    else
        SWAP_PART="${partition_prefix}3"
        ROOT_PART="${partition_prefix}4"
    fi
    
    parted "$tgtdisk" -- mkpart primary ext4 ${swap_end}MiB 100%
else
    if [ "$style" == "uefi" ]; then
        ROOT_PART="${partition_prefix}2"
    else
        ROOT_PART="${partition_prefix}3"
    fi
    
    parted "$tgtdisk" -- mkpart primary ext4 ${NEXT_START}MiB 100%
fi

parted "$tgtdisk" -- name "${ROOT_PART#"$partition_prefix"}" "$root_label"
if [ "$swap" == "hibernate" ]; then
    parted "$tgtdisk" -- name "${SWAP_PART#"$partition_prefix"}" "$swap_label"
fi

## luks

LUKS_TYPE="luks1"
[ "$fde" == "tpm" ] && LUKS_TYPE="luks2"

echo -n "luks password? "
read -r -s PASSWORD
printf '\n'
trap 'unset PASSWORD' EXIT

printf '%s' "$PASSWORD" | cryptsetup luksFormat --type "$LUKS_TYPE" "$ROOT_PART" -
printf '%s' "$PASSWORD" | cryptsetup luksOpen "$ROOT_PART" cryptroot -

if [ "$swap" == "hibernate" ]; then
    printf '%s' "$PASSWORD" | cryptsetup luksFormat --type "$LUKS_TYPE" "$SWAP_PART" -
    printf '%s' "$PASSWORD" | cryptsetup luksOpen "$SWAP_PART" cryptswap -
fi

unset PASSWORD

## fmt

if [ "$style" == "uefi" ]; then
    mkfs.fat -F 32 -n boot "$BOOT_PART"
else
    mkfs.ext4 -L boot "$BOOT_PART"
fi

if [[ "$filesystem" == zfs ]]; then
    parted "$tgtdisk" -- name "${BOOT_PART#"$partition_prefix"}" "$hostn-boot"
    zpool create -o ashift=12 -O compression=lz4 -O mountpoint=none "$hostn" /dev/mapper/cryptroot
    zfs create -o mountpoint=legacy -o com.sun:auto-snapshot=false "$hostn/nix"
    for dataset in root state; do
        zfs create -o mountpoint=legacy -o com.sun:auto-snapshot=true "$hostn/$dataset"
    done
else
    mkfs.ext4 -L nixos /dev/mapper/cryptroot
fi

if [ "$swap" == "hibernate" ]; then
    mkswap -L swap /dev/mapper/cryptswap
fi

## mount

###some fuck shit happens if you don't wait a sec here.
sleep 3

if [[ "$filesystem" == zfs ]]; then
    mount -t zfs "$hostn/root" /mnt
    mkdir -p /mnt/state /mnt/nix
    mount -t zfs "$hostn/nix" /mnt/nix
    mount -t zfs "$hostn/state" /mnt/state
else
    mount /dev/mapper/cryptroot /mnt
fi
mkdir -p /mnt/boot
mount "$BOOT_PART" /mnt/boot

if [ "$swap" == "hibernate" ]; then
    swapon /dev/mapper/cryptswap
fi
